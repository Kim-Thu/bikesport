# Public site origin used to distinguish internal and external links.
NEXT_PUBLIC_SITE_URL=https://example.com

# Storefront data provider.
DATA_SOURCE=json

# MongoDB is optional. Only configure these when DATA_SOURCE=mongodb.
# Production remote MongoDB connections must use mongodb+srv:// or explicitly enable TLS.
# Insecure TLS bypass options are rejected by the application.
# MONGODB_URI=mongodb+srv://username:password@cluster.example.net/
# MONGODB_DB_NAME=bikesport
