# Public site origin used to distinguish internal and external links.
# Copy this file to .env.local and replace the value for your environment.
NEXT_PUBLIC_SITE_URL=https://example.com

# Storefront data provider.
# Keep JSON while building the UI. JSON is the default and requires no database service.
DATA_SOURCE=json

# MongoDB is optional at this stage.
# Only configure these variables when DATA_SOURCE=mongodb and a runtime Mongo connection
# factory has been registered. The Mongo query adapters can be developed without running
# mongod, Docker MongoDB, Compass, or Atlas.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=bikesport
