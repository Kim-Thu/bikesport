# Public site origin used to distinguish internal and external links.
# Copy this file to .env.local and replace the value for your environment.
NEXT_PUBLIC_SITE_URL=https://example.com

# Storefront data provider. JSON remains the local/default adapter.
DATA_SOURCE=json

# MongoDB target configuration. These are intentionally server-only variables.
# Switch DATA_SOURCE=mongodb only after the MongoDB adapter is enabled.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bikesport
